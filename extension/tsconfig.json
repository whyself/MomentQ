{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": {
      "@deepseek-ai/dsh-client-ui-primitives": ["src/dsh/primitives.ts"]
    },
    "types": ["chrome", "node", "vitest/globals"],
    "noEmit": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "tests/**/*.ts", "tests/**/*.tsx", "vite.config.ts", "vite.content.config.ts", "vite.pagebridge.config.ts"],
  "exclude": ["src/vendor"]
}
