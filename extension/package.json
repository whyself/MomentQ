{
  "name": "momentq-browser-extension",
  "version": "1.1.5",
  "private": true,
  "type": "module",
  "scripts": {
    "vendor:dsh": "node scripts/vendor-dsh-frontend.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/copy-ort-assets.mjs && vite build && vite build --config vite.content.config.ts && vite build --config vite.pagebridge.config.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/chrome": "0.2.7",
    "@types/node": "^24.0.0",
    "@types/react": "18.2.79",
    "@types/react-dom": "18.2.25",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "^6.0.3",
    "vite": "6.4.3",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "@shikijs/langs": "^4.4.3",
    "@types/mdast": "^4.0.4",
    "anser": "^2.3.5",
    "clsx": "2.1.1",
    "katex": "^0.16.47",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-math": "^3.0.0",
    "micromark-core-commonmark": "^2.0.3",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-extension-math": "^3.1.0",
    "micromark-factory-space": "^2.0.1",
    "micromark-util-character": "^2.1.1",
    "micromark-util-classify-character": "^2.0.1",
    "micromark-util-sanitize-uri": "^2.0.1",
    "micromark-util-symbol": "^2.0.1",
    "micromark-util-types": "^2.0.2",
    "mp4box": "^2.4.1",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "shiki": "^4.4.3"
  }
